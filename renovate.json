{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>opzkit/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Ignore legacy +incompatible Kubernetes versions (pre-Go modules era)",
      "matchDatasources": [
        "go"
      ],
      "allowedVersions": "!/\\+incompatible$/",
      "matchPackageNames": [
        "/^k8s\\.io//"
      ]
    },
    {
      "description": "Disable updates for operator image in Helm values - managed by release-please",
      "matchFileNames": [
        "helm/database-user-operator/values.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/opzkit/database-user-operator"
      ],
      "enabled": false
    },
    {
      "description": "Group k8s.io/* and sigs.k8s.io/controller-runtime so they bump in lockstep (k8s 0.36 needs controller-runtime 0.24)",
      "groupName": "kubernetes",
      "matchDatasources": [
        "go"
      ],
      "matchPackageNames": [
        "/^k8s\\.io//",
        "sigs.k8s.io/controller-runtime"
      ]
    }
  ]
}
